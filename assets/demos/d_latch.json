{
  "format": "gatequest-workspace",
  "version": 6,
  "root": "main",
  "circuits": [
    {
      "name": "d_latch",
      "title": "D latch",
      "nodes": [
        {"name": "D", "type": "Input", "at": [-350, 60]},
        {"name": "E", "type": "Input", "at": [-350, -60]},
        {"name": "not_d", "use": "gates/not", "at": [-200, -120]},
        {"name": "set", "use": "gates/and", "at": [-50, 60]},
        {"name": "reset", "use": "gates/and", "at": [-50, -60]},
        {"name": "latch", "use": "sr_latch/sr_latch", "at": [120, 0]},
        {"name": "Q", "type": "Output", "at": [300, 0]}
      ],
      "wires": [
        ["D", "set.A", "not_d.A"],
        ["not_d", "reset.A"],
        ["E", "set.B", "reset.B"],
        ["set", "latch.S"],
        ["reset", "latch.R"],
        ["latch.Q", "Q"]
      ]
    },
    {
      "name": "main",
      "title": "D latch",
      "nodes": [
        {"name": "D", "type": "Input", "at": [-300, 60]},
        {"name": "E", "type": "Input", "at": [-300, -60]},
        {"name": "latch", "use": "d_latch", "label": "D latch (gates)", "at": [0, 60]},
        {"name": "prim", "type": "DLatch", "label": "DLatch primitive", "at": [0, -100]},
        {"name": "q_gates", "type": "Output", "label": "Q (gates)", "at": [300, 60]},
        {"name": "q_prim", "type": "Output", "label": "Q (DLatch)", "at": [300, -100]}
      ],
      "wires": [
        ["D", "latch.D", "prim.d"],
        ["E", "latch.E", "prim.en"],
        ["latch", "q_gates"],
        ["prim", "q_prim"]
      ]
    }
  ]
}
