{
  "format": "gatequest-workspace",
  "version": 6,
  "root": "half_adder",
  "circuits": [
    {
      "name": "half_adder",
      "title": "Half adder",
      "nodes": [
        {"name": "A", "type": "Input", "at": [-200, 50]},
        {"name": "B", "type": "Input", "at": [-200, -50]},
        {"name": "xor", "use": "gates/xor", "at": [0, 50]},
        {"name": "and", "use": "gates/and", "at": [0, -50]},
        {"name": "Sum", "type": "Output", "at": [200, 50]},
        {"name": "Carry", "type": "Output", "at": [200, -50]}
      ],
      "wires": [["A", "xor.A", "and.A"], ["B", "xor.B", "and.B"], ["xor", "Sum"], ["and", "Carry"]]
    }
  ]
