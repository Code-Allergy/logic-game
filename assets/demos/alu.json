{
  "format": "gatequest-workspace",
  "version": 6,
  "root": "alu8",
  "circuits": [
    {
      "name": "alu8",
      "title": "8-bit ALU",
      "nodes": [
        {"name": "A", "type": "Input", "w": 8, "at": [-550, 200]},
        {"name": "B", "type": "Input", "w": 8, "at": [-550, 0]},
        {"name": "Op", "type": "Input", "w": 2, "at": [-550, -250]},
        {
          "name": "flip",
          "use": "gates/xor",
          "label": "B xor sub {i}",
          "at": [-350, 300],
          "count": 8,
          "step": [0, -80]
        },
        {"name": "add", "use": "ripple_adder/adder8", "label": "A + B or A - B", "at": [-150, 200]},
        {
          "name": "ands",
          "use": "gates/and",
          "label": "and{i}",
          "at": [-150, 50],
          "count": 8,
          "step": [0, -40]
        },
        {
          "name": "ors",
          "use": "gates/or",
          "label": "or{i}",
          "at": [-50, 50],
          "count": 8,
          "step": [0, -40]
        },
        {"name": "select", "use": "mux_tree/mux4x8", "label": "result", "at": [150, 0]},
        {"name": "any", "type": "ReduceOr", "w": 8, "at": [300, -150]},
        {"name": "none", "use": "gates/not", "at": [400, -150]},
        {"name": "Y", "type": "Output", "w": 8, "at": [550, 0]},
        {"name": "Carry", "type": "Output", "at": [550, 150]},
        {"name": "Zero", "type": "Output", "at": [550, -150]}
      ],
      "wires": [
        ["B", "flip.A", "ands.B", "ors.B"],
        ["Op:0", "flip.B", "add.Cin"],
        ["A", "add.A", "ands.A", "ors.A"],
        ["flip", "add.B"],
        ["add.Sum", "select.D0", "select.D1"],
        ["ands", "select.D2"],
        ["ors", "select.D3"],
        ["Op", "select.Sel"],
        ["select", "Y", "any"],
        ["any", "none"],
        ["none", "Zero"],
        ["add.Cout", "Carry"]
      ]
    }
  ]
}
