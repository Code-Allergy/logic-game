{
  "format": "gatequest-workspace",
  "version": 6,
  "root": "main",
  "circuits": [
    {
      "name": "mag4",
      "title": "4-bit magnitude comparator",
      "nodes": [
        {"name": "A", "type": "Input", "w": 4, "at": [0, 180]},
        {"name": "B", "type": "Input", "w": 4, "at": [0, -180]},
        {
          "name": "a",
          "type": "Split",
          "w": 4,
          "lo": "{i}",
          "len": 1,
          "at": [140, 280],
          "count": 4,
          "step": [0, -60]
        },
        {
          "name": "b",
          "type": "Split",
          "w": 4,
          "lo": "{i}",
          "len": 1,
          "at": [140, -100],
          "count": 4,
          "step": [0, -60]
        },
        {
          "name": "c",
          "use": "comparator/cmp1",
          "label": "bit {i}",
          "at": [320, 120],
          "count": 4,
          "step": [0, -80]
        },
        {"name": "t", "type": "And", "at": [460, 60], "count": 3, "step": [0, -80]},
        {"name": "g", "type": "Or", "at": [580, 20], "count": 3, "step": [0, -80]},
        {"name": "all_eq", "type": "ReduceAnd", "w": 4, "label": "all equal", "at": [600, -340]},
        {"name": "lt", "type": "Nor", "label": "not > and not =", "at": [740, -460]},
        {"name": "Gt", "type": "Output", "at": [880, -140]},
        {"name": "Eq", "type": "Output", "at": [880, -340]},
        {"name": "Lt", "type": "Output", "at": [880, -460]}
      ],
      "wires": [
        ["A", "a"],
        ["B", "b"],
        ["a", "c.A"],
        ["b", "c.B"],
        ["c[1..4].Eq", "t.a"],
        ["c[0].Gt", "t[0].b"],
        ["g[0..2]", "t[1..3].b"],
        ["c[1..4].Gt", "g.a"],
        ["t", "g.b"],
        ["c.Eq", "all_eq"],
        ["g[2]", "Gt", "lt.a"],
        ["all_eq", "Eq", "lt.b"],
        ["lt", "Lt"]
      ]
    },
    {
      "name": "main",
      "title": "4-bit magnitude comparator",
      "nodes": [
        {"name": "A", "type": "Input", "w": 4, "at": [0, 80]},
        {"name": "B", "type": "Input", "w": 4, "at": [0, -80]},
        {"name": "cmp", "use": "mag4", "label": "comparator (gates)", "at": [240, 120]},
        {"name": "gt", "type": "Output", "label": "A > B", "at": [480, 240]},
        {"name": "eq", "type": "Output", "label": "A = B", "at": [480, 120]},
        {"name": "lt", "type": "Output", "label": "A < B", "at": [480, 0]},
        {"name": "eqp", "type": "Eq", "w": 4, "label": "Eq primitive", "at": [240, -120]},
        {"name": "ltp", "type": "LtU", "w": 4, "label": "LtU primitive", "at": [240, -240]},
        {"name": "eq_p", "type": "Output", "label": "A = B (Eq)", "at": [480, -120]},
        {"name": "lt_p", "type": "Output", "label": "A < B (LtU)", "at": [480, -240]}
      ],
      "wires": [
        ["A", "cmp.A", "eqp.a", "ltp.a"],
        ["B", "cmp.B", "eqp.b", "ltp.b"],
        ["cmp.Gt", "gt"],
        ["cmp.Eq", "eq"],
        ["cmp.Lt", "lt"],
        ["eqp", "eq_p"],
        ["ltp", "lt_p"]
      ]
    }
  ]
}
