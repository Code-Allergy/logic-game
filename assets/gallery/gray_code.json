{
  "format": "gatequest-workspace",
  "version": 6,
  "root": "main",
  "circuits": [
    {
      "name": "bin2gray",
      "title": "Binary to Gray code",
      "nodes": [
        {"name": "B", "type": "Input", "w": 4, "at": [0, 0]},
        {"name": "zero", "type": "Const", "value": 0, "at": [140, -200]},
        {
          "name": "hi",
          "type": "Split",
          "w": 4,
          "lo": 1,
          "len": 3,
          "label": "bits 1-3",
          "at": [140, -100]
        },
        {"name": "half", "type": "Merge", "widths": [3, 1], "label": "B >> 1", "at": [280, -100]},
        {"name": "x", "type": "Xor", "w": 4, "at": [420, 0]},
        {"name": "G", "type": "Output", "w": 4, "at": [560, 0]}
      ],
      "wires": [
        ["B", "x.a", "hi"],
        ["hi", "half.a0"],
        ["zero", "half.a1"],
        ["half", "x.b"],
        ["x", "G"]
      ]
    },
    {
      "name": "gray2bin",
      "title": "Gray code to binary",
      "nodes": [
        {"name": "G", "type": "Input", "w": 4, "at": [0, 0]},
        {
          "name": "g",
          "type": "Split",
          "w": 4,
          "lo": "{i}",
          "len": 1,
          "at": [140, 120],
          "count": 4,
          "step": [0, -80]
        },
        {
          "name": "x",
          "type": "Xor",
          "label": "B{i}",
          "at": [280, 120],
          "count": 3,
          "step": [0, -80]
        },
        {"name": "B", "type": "Output", "w": 4, "at": [500, -160]}
      ],
      "wires": [
        ["G", "g"],
        ["g[0..3]", "x.a"],
        ["x[1..3]", "x[0..2].b"],
        ["g[3]", "x[2].b"],
        ["x", "B:0..3"],
        ["g[3]", "B:3"]
      ]
    },
    {
      "name": "main",
      "title": "Gray code",
      "nodes": [
        {"name": "Bin", "type": "Input", "w": 4, "label": "Binary", "at": [0, 0]},
        {"name": "to_gray", "use": "bin2gray", "label": "to Gray", "at": [180, 0]},
        {"name": "from_gray", "use": "gray2bin", "label": "back to binary", "at": [420, 0]},
        {"name": "Gray", "type": "Output", "w": 4, "label": "Gray code", "at": [660, 120]},
        {"name": "Back", "type": "Output", "w": 4, "label": "Binary again", "at": [660, 0]}
      ],
      "wires": [["Bin", "to_gray"], ["to_gray", "from_gray", "Gray"], ["from_gray", "Back"]]
    }
  ]
}
